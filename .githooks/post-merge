#!/bin/sh
# Successful automatic merges regenerate in pre-merge-commit. This read-only
# check also covers fast-forwards; it never hides stale committed bytes behind
# a newly regenerated dirty worktree. A failed check warns after the merge.
root="$(git rev-parse --show-toplevel)" || exit 0
checker="$root/10_Agents/tools/skill_adapters/check_generated.py"
if [ -f "$checker" ]; then
    python3 "$checker" --repo "$root" --revision HEAD ||
        echo "post-merge: committed generated files are stale; regenerate, stage, and commit before pushing" >&2
fi
exit 0
