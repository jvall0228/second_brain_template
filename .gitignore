__pycache__/
*.pyc

# Semantic-search embeddings sidecar (brain spec §18.1): model- and
# machine-specific, regenerated per clone — never committed, unlike the index.
10_Agents/tools/brain/vault-embeddings.json

# Per-clone environment selection and secrets-adjacent overlays (brain spec
# §20). Tracked environment identity lives under 10_Agents/environments/;
# raw local identity, credentials, endpoints, and delivery state live here.
.second-brain/environment
.second-brain/environments/

# Machine-local Cursor overlay artifacts (installed per-clone by
# onboard-harness, reversed by delete — never shared between machines).
.cursor/
.cursorignore
