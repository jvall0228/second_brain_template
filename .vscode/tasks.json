{
  // Second-brain tooling surfaced in VS Code via built-in tasks (no extension,
  // strict first-party trust policy — PRD §6.5). Run via Terminal → Run Task.
  // Requires python3 on PATH (same requirement as the pre-commit hook).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Brain: Validate Vault",
      "type": "shell",
      "command": "\"${workspaceFolder}/brain\" validate",
      "windows": { "command": "\"${workspaceFolder}\\brain.cmd\" validate" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Brain: Rebuild Index",
      "type": "shell",
      "command": "\"${workspaceFolder}/brain\" index",
      "windows": { "command": "\"${workspaceFolder}\\brain.cmd\" index" },
      "problemMatcher": []
    },
    {
      "label": "Brain: Links for Current Note",
      "detail": "Outgoing links, backlinks, and unresolved targets — the backlinks-panel substitute",
      "type": "shell",
      "command": "\"${workspaceFolder}/brain\" links \"${relativeFile}\"",
      "windows": { "command": "\"${workspaceFolder}\\brain.cmd\" links \"${relativeFile}\"" },
      "problemMatcher": []
    },
    {
      "label": "Brain: Search Vault",
      "type": "shell",
      "command": "\"${workspaceFolder}/brain\" search \"${input:brainQuery}\"",
      "windows": { "command": "\"${workspaceFolder}\\brain.cmd\" search \"${input:brainQuery}\"" },
      "problemMatcher": []
    },
    {
      "label": "Brain: Semantic Search",
      "detail": "Relevance-ranked notes via the embeddings sidecar (spec \u00a718); degrades to keyword search when no vectors exist",
      "type": "shell",
      "command": "\"${workspaceFolder}/brain\" search --semantic \"${input:brainSemanticQuery}\"",
      "windows": { "command": "\"${workspaceFolder}\\brain.cmd\" search --semantic \"${input:brainSemanticQuery}\"" },
      "problemMatcher": []
    },
    {
      "label": "Brain: Recent Notes",
      "type": "shell",
      "command": "\"${workspaceFolder}/brain\" recent",
      "windows": { "command": "\"${workspaceFolder}\\brain.cmd\" recent" },
      "problemMatcher": []
    },
    {
      "label": "Brain: Health Report",
      "detail": "Stale-active notes, orphans, Inbox aging, tag drift, and unresolved links (spec §16)",
      "type": "shell",
      "command": "\"${workspaceFolder}/brain\" report",
      "windows": { "command": "\"${workspaceFolder}\\brain.cmd\" report" },
      "problemMatcher": []
    },
    {
      "label": "Brain: Tasks (open)",
      "detail": "Open checkbox tasks across the vault, due-date first (spec §17)",
      "type": "shell",
      "command": "\"${workspaceFolder}/brain\" tasks --open",
      "windows": { "command": "\"${workspaceFolder}\\brain.cmd\" tasks --open" },
      "problemMatcher": []
    },
    {
      "label": "Daily Note: Open Today",
      "detail": "Create today's note from 09_Templates/template-daily-log.md if missing, then open it",
      "type": "shell",
      "command": "python3 10_Agents/tools/vscode/daily_note.py",
      "windows": { "command": "python 10_Agents/tools/vscode/daily_note.py" },
      "problemMatcher": []
    },
    {
      "label": "Homepage: Open Vault Index",
      "detail": "Opens 00_Meta/INDEX.md on folder open (VS Code asks once to allow automatic tasks)",
      "type": "shell",
      // Best-effort: needs the `code` CLI on PATH; silently no-ops otherwise.
      // (sh syntax; the windows variant avoids `||`, which old PowerShell rejects)
      "command": "code -r 00_Meta/INDEX.md || true",
      "windows": { "command": "cmd /c \"code -r 00_Meta/INDEX.md & exit 0\"" },
      "runOptions": { "runOn": "folderOpen" },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "close": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "brainQuery",
      "type": "promptString",
      "description": "Search titles, headings, and body text across the vault"
    },
    {
      "id": "brainSemanticQuery",
      "type": "promptString",
      "description": "Natural-language question to rank vault notes against (semantic search)"
    }
  ]
}
