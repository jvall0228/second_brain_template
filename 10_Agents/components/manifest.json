{
  "manifest_version": 1,
  "components": [
    {
      "id": "i-have-adhd",
      "kind": "skill",
      "provenance": "community",
      "description": "Ten persistent output rules that stop an agent burying the answer: lead with the next action, number multi-step tasks, cap lists, no preamble or recap.",
      "license": "MIT",
      "signoff": "owner-per-item",
      "source": {
        "type": "submodule",
        "path": ".extern/i-have-adhd",
        "repo": "https://github.com/ayghri/i-have-adhd",
        "track": "main",
        "content": "skills/i-have-adhd/SKILL.md"
      },
      "install": {
        "method": "copy",
        "scope": "user",
        "target": "~/.agents/skills/i-have-adhd/"
      },
      "reverse": {
        "method": "delete"
      },
      "catalog": "06_Resources/recommended-skills.md#i-have-adhd"
    },
    {
