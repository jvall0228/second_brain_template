{
  "permissions": {
    "allow": [
      "Bash(brain *)",
      "Bash(python3 -m unittest *)"
    ],
    "deny": [
      "Edit(00_Meta/PRD.md)",
      "Edit(00_Meta/CONVENTIONS.md)",
      "Edit(00_Meta/INDEX.md)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh 10_Agents/harnesses/claude-code/validate-hook.sh"
          }
        ]
      }
    ]
  }
}
